#!/bin/sh
set -eu

python3 - <<'PY'
from pathlib import Path
from datetime import datetime
import re


# DN_DESIGN_TOKENS_GUARD
tokens_path = Path("tokens.css")
if not tokens_path.exists():
    raise SystemExit("ERRO: tokens.css não encontrado.")

tokens_text = tokens_path.read_text(encoding="utf-8")
token_names = set(re.findall(
    r'--([A-Za-z0-9_-]+)\s*:',
    tokens_text
))

violations = []

for css_path in Path(".").glob("*.css"):
    if css_path.name == "tokens.css":
        continue

    css_text = css_path.read_text(encoding="utf-8")

    for token in sorted(token_names):
        if re.search(
            rf'--{re.escape(token)}\s*:',
            css_text
        ):
            violations.append(
                f"{css_path}: --{token}"
            )

if violations:
    print("ERRO: token global definido fora de tokens.css")
    for item in violations:
        print(f"  {item}")
    raise SystemExit(1)

version = Path("VERSION").read_text(
    encoding="utf-8"
).strip()

build = datetime.now().strftime(
    "%Y%m%d-%H%M%S-%f"
)

p = Path("index.html")
s = p.read_text(encoding="utf-8")

s, n1 = re.subn(
    r'(<meta name="dn-version" content=")[^"]*(")',
    lambda m: m.group(1) + version + m.group(2),
    s,
    count=1
)

s, n2 = re.subn(
    r'(<meta name="dn-build" content=")[^"]*(")',
    lambda m: m.group(1) + build + m.group(2),
    s,
    count=1
)

if n1 != 1 or n2 != 1:
    raise SystemExit(
        "ERRO: metadados de versão não encontrados."
    )

assets = [
    "tokens.css",
    "style.css",
    "copiloto.css",
    "config.js",
    "dn-symbols.js",
    "app.js",
    "version-check.js",
    "copiloto.js",
    "dn-ai.js",
]

for asset in assets:
    s = re.sub(
        rf'(["\']){re.escape(asset)}(?:\?v=[^"\']*)?(["\'])',
        rf'\1{asset}?v={build}\2',
        s,
        count=1
    )

p.write_text(s, encoding="utf-8")

print(f"Diário Negro v{version}")
print(f"Build interno: {build}")
PY

git add index.html VERSION
